# ---- Supabase (from your Supabase project: Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: server-only. NEVER expose to the browser. Used by the
# grading and export API routes to read/write across all students.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Anthropic (AI pre-grading) — OPTIONAL ----
# AI pre-grading is OFF by default. Lecturers turn it on and enter their own
# Anthropic key at grading time (used for that run only, never stored), so AI
# usage is billed to whoever runs it, not to the platform owner.
# Only set a key here if the FACULTY wants to centrally fund AI grading for
# everyone. Left blank, the platform runs fully free with manual grading.
ANTHROPIC_API_KEY=
# Grading model. Default is Claude Opus 4.8 (highest quality). You can switch
# to claude-sonnet-5 to lower cost.
GRADING_MODEL=claude-opus-4-8

# ---- Institutional login policy ----
# Only these email domains may sign in. Comma-separated.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=cmu.ac.th
# Default role for a brand-new @cmu.ac.th account on first login.
# Options: student | guest . Lecturers/admins are promoted by an admin.
DEFAULT_NEW_USER_ROLE=student

# ---- Demo / development only ----
# Set to "true" to show an email + password login box on the sign-in page so
# you can log in as the demo accounts created by `npm run seed`, WITHOUT CMU
# SSO. Leave unset (or "false") in production.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false
