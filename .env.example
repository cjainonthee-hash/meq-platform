# =============================================================================
# MEQ Platform - environment variables
# =============================================================================
#
# HOW THIS WORKS
#   This file is the TEMPLATE. It is committed to git and holds no real values.
#   Copy it once and fill in the real values:
#
#       cp .env.example .env.local
#
#   .env.local is the ONE file that holds real secrets on your machine. It is
#   git-ignored and must never be committed. In production the same variables
#   are set in the Vercel dashboard (Settings > Environment Variables), not in
#   a file.
#
# THE NEXT_PUBLIC_ RULE (this is the frontend / backend split)
#   Next.js decides where a variable is allowed to go by its NAME:
#
#     NEXT_PUBLIC_*  ->  FRONTEND. Baked into the JavaScript bundle that is
#                        sent to every student's browser. Anyone can read it
#                        with View Source. Put ONLY public values here.
#
#     everything else -> BACKEND. Stays on the server. Readable only by API
#                        routes, server components and middleware. Secrets
#                        belong here.
#
#   Renaming a backend variable to start with NEXT_PUBLIC_ leaks it to every
#   browser. Never do that to a key or a password.
# =============================================================================


# =============================================================================
# FRONTEND (NEXT_PUBLIC_*)  -  safe to expose, shipped to the browser
# =============================================================================

# Supabase project URL. Supabase > Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anon (public) key. Supabase > Settings > API > anon public.
# Safe in the browser BY DESIGN: it can only do what Row Level Security allows.
# This is not the service role key, do not paste that one here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Which email domains may sign in. Comma-separated, no spaces.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=cmu.ac.th

# Demo / development only. "true" shows an email + password box on the sign-in
# page so you can log in as the accounts created by `npm run seed` without CMU
# SSO. Leave "false" in production.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false


# =============================================================================
# BACKEND (server only)  -  SECRET, never sent to the browser
# =============================================================================

# Supabase service role key. Supabase > Settings > API > service_role.
# This key BYPASSES Row Level Security: it can read and write every student's
# answers and grades. Used by the grading and CSV export API routes, which need
# to work across all students. Never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI pre-grading (optional, OFF by default) ---
# The platform grades manually and costs nothing unless AI grading is switched
# on. A lecturer who wants it enters their OWN Anthropic key at grading time;
# that key is used for that run only and is never stored, so the AI cost is
# billed to whoever ran it.
# Set a key here ONLY if the faculty wants to fund AI grading centrally for
# everyone. Leave it blank otherwise.
ANTHROPIC_API_KEY=

# Grading model. claude-opus-5 is the current default (highest quality).
# Switch to claude-sonnet-5 for a cheaper run.
GRADING_MODEL=claude-opus-5

# Role given to a brand-new account the first time it signs in.
# Options: student | guest . Lecturers and admins are promoted by an admin.
DEFAULT_NEW_USER_ROLE=student

# --- CMU SSO ---
# Custom OAuth flow (not Supabase's built-in Azure provider) driven by our own
# routes (src/app/auth/cmu-start, src/app/auth/callback). Get these from CMU
# IT's Azure app registration for this system.
CMU_AUTHORIZE_URL=
CMU_TOKEN_URL=
CMU_CLIENT_ID=
CMU_CLIENT_SECRET=
CMU_SCOPE=

# The endpoint that returns CMU's "Basic Info" payload (student ID, Thai name,
# faculty, account type) for the signed-in user.
CMU_BASIC_INFO_URL=
